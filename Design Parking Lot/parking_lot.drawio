          <mxGeometry x="300" y="390" width="290" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="t_operator" value="&lt;b&gt;OPERATOR&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;name VARCHAR(100)&lt;br&gt;phone VARCHAR(30)&lt;br&gt;employee_id VARCHAR(50) UNIQUE" style="shape=mxgraph.database.table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
