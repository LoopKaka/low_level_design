        <mxCell id="1" parent="0"/>

        <!-- Tables -->
        <mxCell id="t_parking_lot" value="&lt;b&gt;PARKING_LOT&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;name VARCHAR(100)" style="shape=mxgraph.database.table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
