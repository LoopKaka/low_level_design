          <mxGeometry x="650" y="390" width="260" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="t_ticket" value="&lt;b&gt;TICKET&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;ticket_number VARCHAR(50) UNIQUE&lt;br&gt;FK vehicle_id BIGINT&lt;br&gt;FK parking_spot_id BIGINT&lt;br&gt;FK entry_gate_id BIGINT&lt;br&gt;FK entry_operator_id BIGINT&lt;br&gt;entry_time TIMESTAMP&lt;br&gt;exit_time TIMESTAMP NULL&lt;br&gt;status VARCHAR(20)" style="shape=mxgraph.database.table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
