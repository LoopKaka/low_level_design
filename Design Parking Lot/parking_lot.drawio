        <mxCell id="t_payment" value="&lt;b&gt;PAYMENT&lt;/b&gt;&lt;hr&gt;PK id BIGINT&lt;br&gt;FK bill_id BIGINT&lt;br&gt;amount DECIMAL(12,2)&lt;br&gt;payment_mode VARCHAR(20)&lt;br&gt;payment_status VARCHAR(20)&lt;br&gt;transaction_id VARCHAR(100)&lt;br&gt;paid_at TIMESTAMP NULL" style="shape=mxgraph.database.table;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1" parent="1">
