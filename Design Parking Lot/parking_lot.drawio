        <mxCell id="note1" value="Design note: A payment history is modeled as 1:N from BILL to PAYMENT because retries / multiple payment attempts may exist." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
